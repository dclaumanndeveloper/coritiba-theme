  "description": "Tema inspirado nas cores do Coritiba Football Club - Verde e Branco",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Coritiba Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/coritiba-dark-color-theme.json"
      },
      {
        "label": "Coritiba Light",
        "uiTheme": "vs",
        "path": "./themes/coritiba-light-color-theme.json"
      }
